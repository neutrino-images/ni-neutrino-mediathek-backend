[Unit]
Description=MediathekView-Filmliste nach MariaDB importieren (mv2mariadb)
After=network-online.target mariadb.service
Wants=network-online.target
OnSuccess=mediathek-webtv.service

[Service]
Type=oneshot
User=@SVC_USER@
Group=@SVC_USER@
WorkingDirectory=@IMPORTER_DIR@
ExecStart=/usr/bin/flock -n -E 0 @IMPORTER_DIR@/.import.lock @IMPORTER_DIR@/mv2mariadb --cron-mode 120 --cron-mode-echo
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@IMPORTER_DIR@
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
