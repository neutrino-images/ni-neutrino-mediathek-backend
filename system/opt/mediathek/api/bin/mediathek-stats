#!/usr/bin/python3 -I
# mediathek-stats <Apache-Zugriffslog> <URL von api/info> <Verzeichnis>
# Zählt die Nutzung der Mediathek-API aus dem Zugriffslog (samt den von
# logrotate gedrehten Dateien) und schreibt eine statische Seite index.html.
# IP-Adressen werden nur zum Zählen gelesen: in state.json stehen je Tag
# allein Summen, so dass der Verlauf über die Aufbewahrung der Logs reicht.
import glob, gzip, html, json, os, re, sys, tempfile, time, urllib.request
from datetime import datetime, timedelta

LOG, INFO_URL, OUTDIR = sys.argv[1:4]
STATE = os.path.join(OUTDIR, "state.json")
KEEP_DAYS = 400

# Was das Plugin und Neutrino abrufen; der Pfad ohne /mt-api der Hauptseite
KINDS = [
    ("info", "/api/info", "Plugin-Start"),
    ("channels", "/api/listChannels", "Senderliste"),
    ("search", "/api.html", "Sendungen und Suche"),
    ("live", "/api/listLivestream", "Livestreams im Plugin"),
    ("webtv", "/livestreams.xml", "WebTV-Liste von Neutrino"),
]
BY_PATH = {path: key for key, path, _ in KINDS}
# Abrufe rund um die Livestreams: in den Diagrammen orange, alles andere grau
LIVE = ("live", "webtv")
LINE = re.compile(r'^(\S+) \S+ \S+ \[(\d\d)/(\w{3})/(\d{4}):(\d\d):\d\d:\d\d [^\]]*\] '
                  r'"(\S+) (\S+)[^"]*" (\d{3}) (\S+)')
MONTHS = {m: i for i, m in enumerate(
    ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"], 1)}


def new_day():
    return {"boxes": 0, "kinds": {k: 0 for k, _, _ in KINDS}, "denied": 0,
            "limited": 0, "errors": 0, "bytes": 0, "hours": [0] * 24, "hours_live": [0] * 24}


def log_files():
    files = [LOG] + glob.glob(LOG + ".[0-9]*")
    def age(f):
        m = re.search(r"\.(\d+)(\.gz)?$", f[len(LOG):])
        return int(m.group(1)) if m else 0
    return sorted((f for f in files if os.path.isfile(f)), key=age, reverse=True)


def read_logs():
    days, ips = {}, {}
    for f in log_files():
        with (gzip.open if f.endswith(".gz") else open)(f, "rt", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                m = LINE.match(line)
                if not m:
                    continue
                ip, dd, mon, yyyy, hh, method, path, status, size = m.groups()
                if mon not in MONTHS:
                    continue
                day = "%s-%02d-%s" % (yyyy, MONTHS[mon], dd)
                path = path.split("?", 1)[0]
                if path.startswith("/mt-api/"):
                    path = path[7:]
                kind = BY_PATH.get(path)
                if kind is None:
                    continue  # Startseite, Zertifikatsprüfung, Scanner
                d = days.setdefault(day, new_day())
                status = int(status)
                if status == 429:
                    d["limited"] += 1
                elif status >= 500:
                    d["errors"] += 1
                elif status >= 400:
                    d["denied"] += 1
                elif method in ("GET", "POST"):
                    d["kinds"][kind] += 1
                    d["hours"][int(hh)] += 1
                    if kind in LIVE:
                        d.setdefault("hours_live", [0] * 24)[int(hh)] += 1
                    d["bytes"] += int(size) if size.isdigit() else 0
                    ips.setdefault(day, set()).add(ip)
    for day, s in ips.items():
        days[day]["boxes"] = len(s)
    return days, ips


def total(d):
    return sum(d["kinds"].values())


def live(d):
    return sum(d["kinds"].get(k, 0) for k in LIVE)


def merge(state, days):
    # Ein Tag, den die Logs nur noch zum Teil enthalten (die älteste gedrehte
    # Datei beginnt mitten am Tag), ersetzt den gespeicherten nicht.
    for day, d in days.items():
        old = state.get(day)
        if old is None or total(d) + d["denied"] + d["errors"] + d["limited"] >= \
                total(old) + old["denied"] + old["errors"] + old["limited"]:
            state[day] = d
    for day in sorted(state)[:-KEEP_DAYS]:
        del state[day]
    return state


def api_info():
    try:
        with urllib.request.urlopen(INFO_URL, timeout=10) as r:
            return json.load(r)["entry"][0]
    except Exception:
        return None


def fmt_int(n):
    return "{:,}".format(int(n)).replace(",", ".")


def fmt_time(t):
    return time.strftime("%d.%m.%Y %H:%M", time.localtime(t)) if t else "–"


def fmt_bytes(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1000 or unit == "GB":
            return ("%.0f %s" if unit == "B" else "%.1f %s") % (n, unit)
        n /= 1000.0


def nice_max(v):
    """Obergrenze der Achse: vier gleiche, ganzzahlige, runde Schritte."""
    need, mag = max(v, 1) / 4.0, 1
    while True:
        for step in (1, 1.5, 2, 2.5, 3, 4, 5, 6, 8):
            if step * mag >= need and step * mag == int(step * mag):
                return int(4 * step * mag)
        mag *= 10


def bar_path(cls, x, base, bh, bw, round_top):
    """Säule bzw. Segment von base nach oben; das äußere Ende 4px gerundet."""
    if bh <= 0:
        return ""
    if not round_top:
        return '<rect class="%s" x="%.1f" y="%.1f" width="%.1f" height="%.1f"/>' % (cls, x, base - bh, bw, bh)
    r = min(4.0, bh, bw / 2)
    return '<path class="%s" d="M%.1f,%.1f v%.1f a%.1f,%.1f 0 0 1 %.1f,-%.1f h%.1f a%.1f,%.1f 0 0 1 %.1f,%.1f v%.1f z"/>' % (
        cls, x, base, -(bh - r), r, r, r, r, bw - 2 * r, r, r, r, r, bh - r)


def svg_tip(lines, cx, ytop, w, top):
    """Tooltip ohne Script: SVG-Gruppe, die beim Überfahren der Säule
    erscheint. lines = [(Farbklasse oder None, Text), ...]"""
    lh, pad = 18, 10
    tw = max(len(t) + (2 if c else 0) for c, t in lines) * 7.4 + 2 * pad
    th = len(lines) * lh + 2 * pad - 4
    x = min(max(cx - tw / 2, 0), w - tw)
    y = ytop - th - 10          # über der Säule, notfalls über den Kartenrand
    out = ['<g class="stip" transform="translate(%.1f,%.1f)"><rect rx="8" width="%.1f" height="%.1f"/>' % (x, y, tw, th)]
    for i, (c, t) in enumerate(lines):
        ty = pad + 13 + i * lh
        tx = pad
        if c:
            out.append('<rect class="sw%s" x="%d" y="%d" width="8" height="8" rx="2"/>' % (" s2" if c == "other" else "", tx, ty - 9))
            tx += 14
        out.append('<text x="%d" y="%d">%s</text>' % (tx, ty, html.escape(t)))
    out.append("</g>")
    return "".join(out)


def bar_path(cls, x, base, bh, bw, round_top):
    """Säule bzw. Segment von base nach oben; das äußere Ende 4px gerundet."""
    if bh <= 0:
        return ""
    if not round_top:
        return '<rect class="%s" x="%.1f" y="%.1f" width="%.1f" height="%.1f"/>' % (cls, x, base - bh, bw, bh)
    r = min(4.0, bh, bw / 2)
    return '<path class="%s" d="M%.1f,%.1f v%.1f a%.1f,%.1f 0 0 1 %.1f,-%.1f h%.1f a%.1f,%.1f 0 0 1 %.1f,%.1f v%.1f z"/>' % (
        cls, x, base, -(bh - r), r, r, r, r, bw - 2 * r, r, r, r, r, bh - r)


def bar_chart(values, labels, tips, label_every, title, live=None, cls="bar other"):
    """Säulen mit Grundlinie und Tooltip. Mit live: unten der Anteil der
    Livestreams in Orange, darüber der Rest in Grau, 2px Lücke dazwischen.
    Ohne live eine Reihe in cls; Orange bleibt den Livestreams vorbehalten."""
    w, h, left, right, top, bottom = 1000, 270, 56, 8, 14, 30
    pw, ph = w - left - right, h - top - bottom
    top_v = nice_max(max(values) if values else 0)
    n = max(len(values), 1)
    band = pw / n
    bw = min(30.0, band * 0.7)
    base = top + ph
    out = ['<div class="chart"><svg class="scaled" viewBox="0 0 %d %d" role="img" aria-label="%s">' % (w, h, html.escape(title))]
    for i in range(5):
        v = top_v * i / 4
        y = top + ph - ph * i / 4
        out.append('<line class="%s" x1="%d" x2="%d" y1="%.1f" y2="%.1f"/>' % ("grid" if i else "axis", left, w - right, y, y))
        out.append('<text class="tick" x="%d" y="%.1f" text-anchor="end">%s</text>' % (left - 6, y + 4, fmt_int(v)))
    for i, v in enumerate(labels):
        # Tage von rechts (heute) aus beschriften, Stunden von 0 an
        k = (n - 1 - i) if label_every < 0 else i
        if k % abs(label_every) == 0 or label_every > 0 and i == n - 1 and n <= 24:
            out.append('<text class="tick" x="%.1f" y="%d" text-anchor="middle">%s</text>' % (left + band * i + band / 2, h - 8, html.escape(v)))
    hl, bars, hov = [], [], []
    for i, v in enumerate(values):
        x = left + band * i + (band - bw) / 2
        bh = ph * v / top_v if top_v else 0
        hl.append('<rect class="hl l%d" x="%.1f" y="%d" width="%.1f" height="%d"/>' % (i, left + band * i, top, band, ph))
        if live is None:
            bars.append(bar_path(cls, x, base, bh, bw, True))
        else:
            lv = min(live[i], v)
            lh = ph * lv / top_v if top_v else 0
            rest_h = bh - lh
            bars.append(bar_path("bar", x, base, lh, bw, rest_h <= 0))
            gap = 2.0 if lh > 0 else 0.0
            if rest_h - gap > 0:
                bars.append(bar_path("bar other", x, base - lh - gap, rest_h - gap, bw, True))
        # Oberste Ebene: Fläche zum Überfahren und Tooltip, über allen Säulen
        hov.append('<g class="hov h%d"><rect class="hit" x="%.1f" y="%d" width="%.1f" height="%d"/>%s</g>' % (
            i, left + band * i, top, band, ph, svg_tip(tips[i], x + bw / 2, base - bh, w, top)))
    out += hl + bars + hov
    out.append("</svg></div>")
    return "".join(out)


LEGEND = ('<p class="legend"><span>Livestreams (Plugin und WebTV-Liste)</span>'
          '<span class="s2">Übrige Abrufe</span></p>')


def render(state, ips, info, now):
    today = datetime.fromtimestamp(now).date()
    last = [(today - timedelta(days=i)).isoformat() for i in range(29, -1, -1)]
    data = [state.get(d) or new_day() for d in last]
    wd = ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"]
    # Datumsformen wie Intl de-DE: "18. Nov." auf der Achse,
    # "Di., 18. Nov. 2026" im Tooltip
    mon = ["Jan.", "Feb.", "März", "Apr.", "Mai", "Juni", "Juli", "Aug.", "Sept.", "Okt.", "Nov.", "Dez."]
    def dlabel(iso, wday=False):
        dt = datetime.strptime(iso, "%Y-%m-%d")
        short = "%d. %s" % (dt.day, mon[dt.month - 1])
        return "%s., %s %d" % (wd[dt.weekday()], short, dt.year) if wday else short

    week = set()
    for d in last[-7:]:
        week |= ips.get(d, set())
    t, y = data[-1], data[-2]
    sum7 = sum(total(d) for d in data[-7:])
    sum30 = sum(total(d) for d in data)
    hours = [sum(d["hours"][hh] for d in data[-7:]) for hh in range(24)]
    hours_live = [sum(d.get("hours_live", [0] * 24)[hh] for d in data[-7:]) for hh in range(24)]

    kpis = [
        ("Boxen heute", fmt_int(t["boxes"]), "gestern %s" % fmt_int(y["boxes"])),
        ("Boxen in 7 Tagen", fmt_int(len(week)), "verschiedene Adressen"),
        ("Anfragen heute", fmt_int(total(t)), "gestern %s" % fmt_int(total(y))),
        ("Anfragen in 30 Tagen", fmt_int(sum30), "%s in 7 Tagen" % fmt_int(sum7)),
    ]
    rows = []
    for key, _, name in KINDS:
        rows.append("<tr><th scope=\"row\">%s</th><td>%s</td><td>%s</td><td>%s</td></tr>" % (
            html.escape(name), fmt_int(t["kinds"][key]),
            fmt_int(sum(d["kinds"][key] for d in data[-7:])), fmt_int(sum(d["kinds"][key] for d in data))))
    problems = [
        ("Abgewiesen (unerlaubte Anfrage)", "denied"),
        ("Gebremst (zu viele Anfragen, 429)", "limited"),
        ("Serverfehler (5xx)", "errors"),
    ]
    prow = "".join("<tr><th scope=\"row\">%s</th><td>%s</td><td>%s</td><td>%s</td></tr>" % (
        name, fmt_int(t[k]), fmt_int(sum(d[k] for d in data[-7:])), fmt_int(sum(d[k] for d in data)))
        for name, k in problems)
    daily = "".join("<tr><th scope=\"row\">%s</th><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>" % (
        dlabel(day, True), fmt_int(d["boxes"]), fmt_int(total(d)), fmt_int(live(d)), fmt_int(total(d) - live(d)),
        fmt_bytes(d["bytes"]))
        for day, d in reversed(list(zip(last, data))))
    # Tabelle zum Diagramm, aufklappbar
    daily_html = ('<details><summary>Als Tabelle anzeigen</summary><div class="scroll"><table><thead><tr>'
                  '<th>Tag</th><th>Boxen</th><th>Anfragen</th><th>Livestreams</th><th>Übrige</th><th>Daten</th>'
                  '</tr></thead><tbody>%s</tbody></table></div></details>' % daily)

    if info:
        db = "%s Einträge · Filmliste vom %s · eingelesen %s" % (
            fmt_int(info.get("mventrys", 0)), fmt_time(info.get("mvdate")), fmt_time(info.get("vdate")))
        ver = "API %s · Importer %s" % (html.escape(str(info.get("apiversion", "?"))), html.escape(str(info.get("progversion", "?"))))
    else:
        db, ver = "Datenbank gerade nicht erreichbar", ""

    charts = [
        ("Boxen pro Tag", "letzte 30 Tage",
         bar_chart([d["boxes"] for d in data], [dlabel(d) for d in last],
                   [[(None, dlabel(day, True)), (None, "%s Boxen" % fmt_int(d["boxes"]))] for day, d in zip(last, data)], -4, "Boxen pro Tag")),
        ("Anfragen pro Tag", "letzte 30 Tage",
         bar_chart([total(d) for d in data], [dlabel(d) for d in last],
                   [[(None, dlabel(day, True)), (None, "%s Anfragen" % fmt_int(total(d))),
                     ("live", "Livestreams %s" % fmt_int(live(d))), ("other", "Übrige %s" % fmt_int(total(d) - live(d)))]
                    for day, d in zip(last, data)], -4, "Anfragen pro Tag", [live(d) for d in data])),
        ("Anfragen nach Uhrzeit", "letzte 7 Tage, Summe je Stunde",
         bar_chart(hours, ["%d" % hh for hh in range(24)],
                   [[(None, "%02d–%02d Uhr" % (hh, (hh + 1) % 24)), (None, "%s Anfragen" % fmt_int(v)),
                     ("live", "Livestreams %s" % fmt_int(hours_live[hh])), ("other", "Übrige %s" % fmt_int(v - hours_live[hh]))]
                    for hh, v in enumerate(hours)], 3, "Anfragen nach Uhrzeit", hours_live)),
    ]
    chart_html = "".join(
        '<section class="card"><h2>%s</h2><p class="sub">%s</p>%s%s%s</section>' % (
            a, b, LEGEND if '<path class="bar"' in c or '<rect class="bar"' in c else "", c, daily_html if a == "Anfragen pro Tag" else "")
        for a, b, c in charts)
    kpi_html = "".join(
        '<div class="kpi"><div class="label">%s</div><div class="value">%s</div><div class="sub">%s</div></div>' % k for k in kpis)

    page = """<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mediathek-API · Nutzung</title>
<link rel="icon" href="https://www.neutrino-images.de/favicon.ico">
<style>
/* Neutrino-Images · Statistikseiten (Designsystem Neutrino-Images) */
:root {
  color-scheme: dark;
  --page: #212121; --surface: #424242; --surface-hover: #4f4f4f; --surface-head: #616161;
  --divider: #212121; --ink: #e0e0e0; --ink-muted: #bdbdbd;
  --accent: #fd6d13; --on-accent: #000000; --accent-soft: #fd6d1333;
  --chart-other: #9e9e9e; --chart-alert: #f44336; --chart-baseline: #757575;
  --font-sans: Ubuntu, Verdana, Helvetica, Arial, sans-serif;
  --radius-card: 10px; --radius-control: 8px;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--page); color: var(--ink-muted); font: 15px/1.5 var(--font-sans); }
a { color: var(--ink); text-decoration: none; }
a:hover { color: var(--accent); }
main { max-width: 1080px; margin: 0 auto; padding: 24px 16px 40px; }

/* Kopf: Logo 85 × 65 links neben dem Titel, Stand darunter */
header { display: flex; align-items: center; gap: 12px; }
header .logo { display: flex; flex: none; }
header .logo img, header .logo svg { width: 85px; height: 65px; display: block; }
h1 { font-size: 1.5em; font-weight: normal; line-height: 65px; margin: 0; color: var(--ink); }
h2 { font-size: 16px; font-weight: bold; margin: 0; color: var(--ink); }
.meta { margin: 8px 0 0; }
.sub { margin: 0; }

/* Schalter (nur auf Seiten mit Script) */
.filters { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; margin: 24px 0 0; }
.seg { display: inline-flex; border-radius: var(--radius-control); overflow: hidden; background: var(--surface); }
.seg button { border: 0; background: none; color: var(--ink-muted); font: inherit; font-size: 14px;
  padding: 6px 12px; cursor: pointer; border-right: 1px solid var(--divider); white-space: nowrap; }
.seg button:last-child { border-right: 0; }
.seg button[aria-pressed="true"] { background: var(--accent); color: var(--on-accent); }
.seg button:hover:not([aria-pressed="true"]) { background: var(--surface-hover); color: var(--ink); }
.seg button:focus-visible, select:focus-visible, .check input:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
label.sel, .check { color: var(--ink-muted); font-size: 14px; display: inline-flex; gap: 8px; align-items: center; }
.check { cursor: pointer; }
.check input { accent-color: var(--accent); width: 16px; height: 16px; margin: 0; }
