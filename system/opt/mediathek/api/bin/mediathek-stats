/* Tooltip: als HTML (Seiten mit Script) oder als SVG-Gruppe (ohne Script) */
.tip { position: absolute; pointer-events: none; background: var(--surface-head); color: var(--ink);
  border-radius: var(--radius-control); padding: 6px 10px; font-size: 13px; white-space: nowrap;
  transform: translate(-50%, calc(-100% - 10px)); opacity: 0; transition: opacity .08s; }
.tip .sw { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 5px; background: var(--accent); }
.tip .sw.s2 { background: var(--chart-other); }
.tip .sw.s3 { background: var(--chart-alert); }
.chart .stip { visibility: hidden; pointer-events: none; }
.chart .hov:hover .stip { visibility: visible; }
.chart .stip rect { fill: var(--surface-head); }
.chart .stip text { fill: var(--ink); font-size: 13px; }
.chart .stip rect.sw { fill: var(--accent); }
.chart .stip rect.sw.s2 { fill: var(--chart-other); }
.chart .stip rect.sw.s3 { fill: var(--chart-alert); }

/* Tabellen */
table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 14px; font-variant-numeric: tabular-nums; }
th, td { padding: 6px 8px; border-bottom: 1px solid var(--divider); text-align: right; vertical-align: top; }
td { color: var(--ink); }
th:first-child, td:first-child, th[scope=row] { text-align: left; font-weight: normal; }
thead th, tr.head th { background: var(--surface-head); color: var(--ink); font-weight: normal; font-size: 13px; white-space: nowrap; }
tbody tr:hover, tr:not(.head):hover { background: var(--surface-hover); }
td.file, td.ua { font-family: monospace; font-size: 12.5px; word-break: break-all; text-align: left; }
td.dir { color: var(--ink-muted); white-space: nowrap; font-size: 13px; text-align: left; }
.empty { color: var(--ink-muted); padding: 24px 0; text-align: center; }
details { margin-top: 12px; }
summary { cursor: pointer; color: var(--ink); border-radius: var(--radius-control); padding: 4px 8px; margin: -4px -8px; }
